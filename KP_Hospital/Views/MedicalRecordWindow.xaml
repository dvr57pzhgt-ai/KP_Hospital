<Window x:Class="KP_Hospital.Views.MedicalRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KP_Hospital.Views"
        mc:Ignorable="d"
     Title="История болезни" Height="800" Width="850" 
        WindowStartupLocation="CenterOwner" Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPatientName" Grid.Row="0" Text="Пациент: " FontSize="20" FontWeight="Bold" 
                   Foreground="#1976D2" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
              
                <ColumnDefinition Width="1*"/>
               
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <DataGrid x:Name="dataGridHistory" AutoGenerateColumns="False" IsReadOnly="True" 
                          CanUserAddRows="False" Background="White" RowBackground="White" 
                          AlternatingRowBackground="#E3F2FD" BorderBrush="#B0BEC5" BorderThickness="1"
                          RowHeight="30" ColumnHeaderHeight="35">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#E3F2FD"/>
                            <Setter Property="Foreground" Value="#0D47A1"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding VisitDate}" Width="90"/>
                        <DataGridTextColumn Header="Диагноз" Binding="{Binding DiagnosisName}" Width="130"/>
                        <DataGridTextColumn Header="Жалобы" Binding="{Binding Complaints}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15">
                <Border.Effect>
                    <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Новый прием" FontSize="18" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,10"/>

                    <TextBlock Text="Диагноз:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbDiagnosis" Height="30" Margin="0,0,0,10" DisplayMemberPath="Name" />

                    <TextBlock Text="Жалобы:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtComplaints" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" BorderBrush="#90CAF9" Margin="0,0,0,10" TextChanged="Input_TextChanged"/>

                    <TextBlock Text="Осмотр:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtObjective" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" BorderBrush="#90CAF9" Margin="0,0,0,10" TextChanged="Input_TextChanged"/>

                    <TextBlock Text="Лечение:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTreatment" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" BorderBrush="#90CAF9" Margin="0,0,0,10" TextChanged="Input_TextChanged"/>

                    <TextBlock Text="Назначение (Лекарство):" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMedication" Height="30" Padding="5" BorderBrush="#90CAF9" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Отменить" Click="BtnUndo_Click" Width="90" Height="35" Margin="0,0,10,0" 
                                Background="#FF9800" Foreground="White" BorderThickness="0"/>
                        <Button Content="Сохранить" Click="BtnSave_Click" Width="100" Height="35" 
                                Background="#1976D2" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>