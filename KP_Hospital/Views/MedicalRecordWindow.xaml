<Window x:Class="KP_Hospital.Views.MedicalRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KP_Hospital.Views"
        mc:Ignorable="d"
     Title="История болезни" Height="750" Width="950" 
        WindowStartupLocation="CenterOwner" Background="#F0F8FF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtPatientName" Grid.Row="0" Text="Пациент: " FontSize="20" FontWeight="Bold" 
                   Foreground="#1E3A5F" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Показать всю историю" Grid.Row="0" Click="BtnShowAllHistory_Click" 
                            Height="32" Margin="0,0,0,15" Background="#BBDEFB" Foreground="#1E3A5F" 
                            BorderThickness="0" HorizontalAlignment="Left" Width="180" FontWeight="SemiBold" Cursor="Hand"/>

                    <DataGrid x:Name="dataGridHistory" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              CanUserAddRows="False" Background="Transparent" RowBackground="White" 
                              AlternatingRowBackground="#F4F9FD" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                              RowHeight="35" ColumnHeaderHeight="40" MouseDoubleClick="DataGridHistory_MouseDoubleClick">
                       
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                        <Setter Property="Foreground" Value="#B71C1C"/>
                                        <Setter Property="ToolTip" Value="Рецепт просрочен (выписан более 30 дней назад)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E6F2F8"/>
                                <Setter Property="Foreground" Value="#34515E"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#B3D4E0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding VisitDate}" Width="80"/>
                            <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="140"/>
                            <DataGridTextColumn Header="Диагноз" Binding="{Binding DiagnosisName}" Width="110"/>
                            <DataGridTextColumn Header="Жалобы" Binding="{Binding Complaints}" Width="*"/>

                            <DataGridTextColumn Header="Больничный" Binding="{Binding SickLeaveStatus}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Новый прием" FontSize="20" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,15"/>

                    <TextBlock Text="Диагноз:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cmbDiagnosis" Height="32" Margin="0,0,0,15" 
                              IsEditable="True" IsTextSearchEnabled="True" 
                              DisplayMemberPath="Name" TextSearch.TextPath="Name"
                              BorderBrush="#CFD8DC" Padding="5"/>       

                    <TextBlock Text="Жалобы:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtComplaints" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" BorderBrush="#CFD8DC" Margin="0,0,0,15" TextChanged="Input_TextChanged" FontSize="14"/>

                    <TextBlock Text="Объективный статус:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtObjective" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" BorderBrush="#CFD8DC" Margin="0,0,0,15" TextChanged="Input_TextChanged" FontSize="14"/>

                    <TextBlock Text="План лечения:" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTreatment" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                             Padding="5" BorderBrush="#CFD8DC" Margin="0,0,0,15" TextChanged="Input_TextChanged" FontSize="14"/>

                    <TextBlock Text="Назначение (Лекарство):" Foreground="#546E7A" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtMedication" Height="32" Padding="5" BorderBrush="#CFD8DC" Margin="0,0,0,20" FontSize="14"/>
                    <CheckBox x:Name="chkSickLeave" Content="Выдать больничный лист (7 дней)" 
          Foreground="#546E7A" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                       
                        <Button Content="Закрыть" Click="BtnClose_Click" Width="90" Height="35" Margin="0,0,10,0" 
                                Background="#E0E0E0" Foreground="#333333" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                        <Button Content="Отменить" Click="BtnUndo_Click" Width="100" Height="35" Margin="0,0,10,0" 
                                Background="#E3F2FD" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                        <Button Content="Сохранить" Click="BtnSave_Click" Width="110" Height="35" 
                                Background="#A2D2FF" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>