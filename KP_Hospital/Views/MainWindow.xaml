<Window x:Class="KP_Hospital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинская система" Height="650" Width="1000" 
        WindowStartupLocation="CenterScreen" Background="#F0F8FF">
   

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="60"/>
           
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="*"/>
           
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#E6F2F8">
            <MenuItem Header="Файл" Foreground="#34515E">
                <MenuItem Header="Выход" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="Справка" Foreground="#34515E">
                <MenuItem Header="О программе" Click="MenuAbout_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="#A2D2FF">
            <TextBlock Text="Медицинская информационная система" 
                       Foreground="#1E3A5F" FontSize="22" FontWeight="SemiBold" 
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <Border Grid.Row="2" Background="White" Margin="20,15,20,10" Padding="15" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск (ФИО / Полис):" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#546E7A" FontSize="14"/>

                <TextBox x:Name="txtSearch" Width="220" Height="32" Padding="5" BorderBrush="#CFD8DC" 
             Margin="0,0,15,0" VerticalContentAlignment="Center" FontSize="14"/>

                <Button Content="Найти" Click="BtnSearch_Click" Width="90" Height="32" Margin="0,0,10,0" 
            Background="#BBDEFB" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Content="Сбросить" Click="BtnReset_Click" Width="100" Height="32" Margin="0,0,20,0" 
            Background="#E3F2FD" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Content="+ Добавить пациента" Click="BtnAddPatient_Click" Width="170" Height="32" 
            Background="#A2D2FF" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Content="Удалить пациента" Click="BtnDeletePatient_Click" Width="150" Height="32" Margin="10,0,0,0" 
            Background="#FFCDD2" Foreground="#B71C1C" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Content="Уведомления" Click="BtnNotifications_Click" Width="130" Height="32" Margin="10,0,0,0" 
            Background="#90CAF9" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>

                <Button Content="Отчет по пациентам" Click="BtnGenerateReport_Click" Width="160" Height="32" Margin="10,0,0,0" 
            Background="#BBDEFB" Foreground="#1E3A5F" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" Margin="20,0,20,20" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#B0BEC5" BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>

            <DataGrid x:Name="dataGridPatients" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="Transparent"
                      RowBackground="White" 
                      AlternatingRowBackground="#F4F9FD" 
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0"
                      RowHeight="40" ColumnHeaderHeight="40"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E6F2F8"/>
                        <Setter Property="Foreground" Value="#34515E"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#B3D4E0"/>
                        <Setter Property="Height" Value="45"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding ФИО}" Width="*"/>
                    <DataGridTextColumn Header="Дата рождения" Binding="{Binding ДатаРождения}" Width="150"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Телефон}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>