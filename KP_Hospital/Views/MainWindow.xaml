<Window x:Class="KP_Hospital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинская система" Height="650" Width="1000" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Верхняя панель -->
            <RowDefinition Height="Auto"/>
            <!-- Панель поиска -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель (Header) -->
        <Border Grid.Row="0" Background="#1976D2">
            <TextBlock Text="Медицинская информационная система" 
                       Foreground="White" FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="20,0"/>
        </Border>

        <!-- Панель управления -->
        <Border Grid.Row="1" Background="White" Margin="15" Padding="10" CornerRadius="5">
            <Border.Effect>
                <DropShadowEffect Color="#CFD8DC" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поиск по ФИО:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#546E7A"/>

                <TextBox x:Name="txtSearch" Width="250" Height="30" Padding="5" BorderBrush="#B0BEC5" Margin="0,0,10,0"/>

                <Button Content="Найти" Click="BtnSearch_Click" Width="80" Height="30" Margin="0,0,10,0" Background="#1976D2" Foreground="White"/>
                <Button Content="Сбросить" Click="BtnReset_Click" Width="90" Height="30" Margin="0,0,20,0" Background="#1976D2" Foreground="White"/>
                <Button Content="+ Добавить пациента" Click="BtnAddPatient_Click" Width="160" Height="30" Background="#43A047" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <DataGrid x:Name="dataGridPatients" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Background="White" RowBackground="White" AlternatingRowBackground="#E3F2FD"
                  BorderBrush="#B0BEC5" BorderThickness="1"
                  Margin="15,0,15,15"
                  RowHeight="35" ColumnHeaderHeight="40">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#0D47A1"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#90CAF9"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding ФИО}" Width="*"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding ДатаРождения}" Width="150"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Телефон}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>