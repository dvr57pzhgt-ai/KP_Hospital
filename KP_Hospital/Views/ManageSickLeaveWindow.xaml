<Window x:Class="KP_Hospital.Views.ManageSickLeaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KP_Hospital.Views"
        mc:Ignorable="d"
        Title="Управление больничным" Height="300" Width="400" 
        WindowStartupLocation="CenterOwner" Background="#F0F8FF">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="Управление больничным листом" FontSize="18" FontWeight="Bold" Foreground="#1E3A5F" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                <TextBlock x:Name="txtStatus" Text="Текущий статус:" FontSize="14" Margin="0,0,0,20"/>

                <Button Content="Снять с больничного" Click="BtnCloseSickLeave_Click" 
                        Height="35" Margin="0,0,0,10" Background="#FFCDD2" Foreground="#B71C1C" FontWeight="Bold" BorderThickness="0"/>

                <Button Content="Продлить на 7 дней" Click="BtnExtendSickLeave_Click" 
                        Height="35" Background="#A2D2FF" Foreground="#1E3A5F" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>