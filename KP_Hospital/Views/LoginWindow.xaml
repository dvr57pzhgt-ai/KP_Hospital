<Window x:Class="KP_Hospital.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация врача" Height="400" Width="450" 
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Grid>
        <Border Background="White" CornerRadius="10" Width="350" Padding="30" 
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#B0BEC5" BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Вход в систему" FontSize="24" FontWeight="Bold" 
                           Foreground="#1976D2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Логин/Номер полиса" FontSize="14" Foreground="#546E7A" Margin="0,0,0,5"/>

                <TextBox x:Name="txtLogin" Height="35" Padding="5" FontSize="14" BorderBrush="#90CAF9" BorderThickness="1"/>

                <TextBlock Text="Пароль" FontSize="14" Foreground="#546E7A" Margin="0,15,0,5"/>
                <PasswordBox x:Name="txtPassword" Height="35" Padding="5" FontSize="14" 
             BorderBrush="#90CAF9" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <RadioButton x:Name="rbDoctor" Content="Врач" IsChecked="True" Margin="0,0,20,0" Foreground="#546E7A"/>
                    <RadioButton x:Name="rbPatient" Content="Пациент" Foreground="#546E7A"/>
                </StackPanel>
                <Button Content="Войти" Click="BtnLogin_Click" 
                        Height="40" Margin="0,25,0,0" FontSize="16" FontWeight="SemiBold"
                        Background="#1976D2" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>